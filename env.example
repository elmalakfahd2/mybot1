# انسخ هذا الملف باسم .env وحط قيمك الحقيقية جواه (للتشغيل المحلي فقط)
# ملف .env نفسه ما يترفعش على GitHub أبدًا (موجود في .gitignore)
#
# على Railway: متحطش .env، حط نفس المتغيرات دي في تبويب Variables

# ==================== Binance ====================
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ==================== Telegram ====================
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ==================== Groq AI ====================
GROQ_API_KEY=

# ==================== SambaNova ====================
SAMBANOVA_API_KEY=

# true = حساب تجريبي (آمن) | false = حساب حقيقي بفلوس فعلية
USE_TESTNET=true
